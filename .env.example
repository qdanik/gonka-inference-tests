# Copy to `.env` (gitignored) and fill in. It is auto-loaded by e2e/gateway:
#   python -m e2e.gateway run
# NEVER commit the real .env — this repo is public.

export GONKA_GATEWAY_ADMIN_KEY=sk-admin-...      # gateway admin Bearer key
export GONKA_SSH_HOST=user@host                  # how to reach the gateway box
export GONKA_SSH_PORT=22                          # SSH port
export GONKA_GATEWAY_URL=http://127.0.0.1:18080   # gateway address on the server
