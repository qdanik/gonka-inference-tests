{
  "name": "minimax_tool_name_whitespace",
  "description": "A whitespace-only MiniMax tool entry name is rejected. Without the trim it passes the gateway, reaches the tool parser, and hangs the request to the deadline (0 bytes, ties up a slot).",
  "models": [
    "MiniMaxAI/MiniMax-M2.7"
  ],
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "What is the weather in Tokyo?"
      },
      {
        "role": "assistant",
        "content": "Checking the weather.",
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\":\"Tokyo\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": [
          {
            "name": "   ",
            "type": "text",
            "text": "x"
          }
        ]
      }
    ],
    "max_tokens": 16
  },
  "expect": {
    "outcome": "reject",
    "status": 400,
    "message_contains": "content",
    "max_latency_s": 30
  }
}
