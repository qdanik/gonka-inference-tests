{
  "name": "minimax_tool_name_too_long",
  "description": "MiniMax tool entry with a name longer than 64 bytes is rejected.",
  "models": [
    "MiniMaxAI/MiniMax-M2.7"
  ],
  "request": {
    "messages": [
      {
        "role": "user",
        "content": "What is the weather in Tokyo?"
      },
      {
        "role": "assistant",
        "content": "Checking the weather.",
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\":\"Tokyo\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": [
          {
            "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "type": "text",
            "text": "x"
          }
        ]
      }
    ],
    "max_tokens": 16
  },
  "expect": {
    "outcome": "reject",
    "status": 400,
    "message_contains": "content"
  }
}
